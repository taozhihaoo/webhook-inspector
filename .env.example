# Webhook Inspector — environment template.
# Copy to .env and fill in real values. NEVER commit a real .env.

# --- Required secrets (the app refuses to start without them) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=change-me-admin-token
SECRET_KEY=change-me-secret-key

# --- Database (PostgreSQL via docker compose; adjust host/port as needed) ---
DATABASE_URL=postgresql+asyncpg://webhook:webhook@db:5432/webhook_inspector
POSTGRES_PASSWORD=webhook

# --- Public base URL used when building webhook URLs (empty = derive from request) ---
BASE_URL=http://localhost:8000
APP_PORT=8000

# --- CORS (comma-separated list; only needed when the frontend is served
#     from a different origin, e.g. the Vite dev server) ---
CORS_ORIGINS=http://localhost:5173

# --- Replay security (defaults are the safe values shown here) ---
# Allow http:// replay targets (default: https only)
ALLOW_HTTP_REPLAY=false
# Allow replay to private/loopback addresses (default: blocked).
# Only for local demos of the mock receiver — never on public deployments.
REPLAY_ALLOW_PRIVATE_NETWORKS=false

# --- Development helpers ---
# Mounts POST /mock/receiver (dev/demo only; keep false in production).
ENABLE_MOCK_RECEIVER=false
